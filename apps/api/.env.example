NODE_ENV=development
APP_PORT=3310
APP_SECRET=REPLACE_WITH_A_SECRET_OF_AT_LEAST_32_CHARACTERS
DEMO_ADMIN_PASSWORD=CHOOSE_A_LOCAL_DEMO_PASSWORD_OF_AT_LEAST_12_CHARACTERS
JWT_ACCESS_TOKEN_TTL_SECONDS=900
# Independent registration limit per IP.
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_MS=60000
CLIENT_URL=http://localhost:3000
# Exact IPv4/IPv6 addresses of reverse proxies, comma-separated. Empty = none.
# Keep empty locally. In production, use the proxy's fixed internal address.
TRUSTED_PROXY_IPS=
# Optional absolute path; defaults to ~/.lucarne/bug-reports.json.
BUG_REPORTS_FILE_PATH=
# Optional absolute directory; defaults to ~/.lucarne/upload.
UPLOAD_DIRECTORY=

DATABASE_URL=postgresql://user:password@localhost:5435/lucarne
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5436/lucarne_test
