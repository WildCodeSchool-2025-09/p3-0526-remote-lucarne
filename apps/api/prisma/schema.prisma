generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AppUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  avatarUrl    String?   @map("avatar_url")
  status       String    @default("PENDING_VERIFICATION") @db.VarChar(30)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role      @relation(fields: [roleId], references: [id], onUpdate: NoAction, map: "fk_user_role")

  @@index([roleId], map: "idx_user_role")
  @@map("app_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model GameMatch {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchPublicId String     @unique(map: "uq_match_public_id") @default(dbgenerated("gen_random_uuid()")) @map("match_public_id") @db.Uuid
  matchdayId  String       @map("matchday_id") @db.Uuid
  homeTeamId  String?      @map("home_team_id") @db.Uuid
  awayTeamId  String?      @map("away_team_id") @db.Uuid
  matchDate   DateTime?    @map("match_date") @db.Date
  startTime   DateTime?    @map("start_time") @db.Time(6)
  stadium     String?      @db.VarChar(150)
  homeScore   Int?         @map("home_score")
  awayScore   Int?         @map("away_score")
  status      String       @default("SCHEDULED") @db.VarChar(30)
  isPublished Boolean      @default(false) @map("is_published")
  isActive    Boolean      @default(true) @map("is_active")
  version     Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  awayTeam    Team?        @relation("AwayTeamMatches", fields: [awayTeamId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_match_away_team")
  homeTeam    Team?        @relation("HomeTeamMatches", fields: [homeTeamId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_match_home_team")
  matchday    Matchday     @relation(fields: [matchdayId], references: [id], onUpdate: NoAction, map: "fk_match_matchday")
  matchEvents MatchEvent[]
  teamReservations MatchTeamReservation[]

  @@index([awayTeamId], map: "idx_match_away_team")
  @@index([matchDate], map: "idx_match_date")
  @@index([homeTeamId], map: "idx_match_home_team")
  @@index([matchdayId], map: "idx_match_matchday")
  @@index([status], map: "idx_match_status")
  @@map("game_match")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model League {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Generated by the insert trigger and preserved when the league is renamed.
  slug      String   @unique(map: "uq_league_slug") @default(dbgenerated()) @db.VarChar(190)
  name      String   @db.VarChar(150)
  country   String   @db.VarChar(100)
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(false) @map("is_active")
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  leagueSeasons LeagueSeason[]

  @@unique([name, country], map: "uq_league_name_country")
  @@map("league")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MatchEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String    @map("match_id") @db.Uuid
  playerId  String    @map("player_id") @db.Uuid
  eventType String    @default("GOAL") @map("event_type") @db.VarChar(50)
  minute    Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  gameMatch GameMatch @relation(fields: [matchId], references: [id], onUpdate: NoAction, map: "fk_event_match")
  player    Player    @relation(fields: [playerId], references: [id], onUpdate: NoAction, map: "fk_event_player")

  @@index([matchId], map: "idx_event_match")
  @@index([playerId], map: "idx_event_player")
  @@map("match_event")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Matchday {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueSeasonId String   @map("league_season_id") @db.Uuid
  number      Int
  name        String?     @db.VarChar(100)
  startDate   DateTime?   @map("start_date") @db.Date
  endDate     DateTime?   @map("end_date") @db.Date
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  gameMatches GameMatch[]
  teamReservations MatchTeamReservation[]
  leagueSeason LeagueSeason @relation(fields: [leagueSeasonId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_matchday_league_season")

  @@unique([leagueSeasonId, number], map: "uq_matchday_league_season_number")
  @@index([leagueSeasonId], map: "idx_matchday_league_season")
  @@map("matchday")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Participation {
  teamId         String   @map("team_id") @db.Uuid
  leagueSeasonId String   @map("league_season_id") @db.Uuid
  registrationAt DateTime @default(now()) @map("registration_at") @db.Timestamptz(6)
  points         Int      @default(0)
  rank           Int?
  status         String   @default("REGISTERED") @db.VarChar(30)
  leagueSeason   LeagueSeason @relation(fields: [leagueSeasonId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_participation_league_season")
  team           Team     @relation(fields: [teamId], references: [id], onUpdate: NoAction, map: "fk_participation_team")

  @@id([teamId, leagueSeasonId], map: "pk_participation")
  @@index([leagueSeasonId], map: "idx_participation_league_season")
  @@index([leagueSeasonId, status], map: "idx_participation_league_season_status")
  @@map("participation")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Player {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName   String       @map("first_name") @db.VarChar(100)
  lastName    String       @map("last_name") @db.VarChar(100)
  nationality String?      @db.VarChar(100)
  position    String?      @db.VarChar(50)
  birthday    DateTime?    @db.Date
  pictureUrl  String?      @map("picture_url")
  isActive    Boolean      @default(true) @map("is_active")
  version     Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  matchEvents MatchEvent[]
  teamPlayers TeamPlayer[]

  @@index([lastName, firstName], map: "idx_player_name")
  @@map("player")
}

model TeamPlayer {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  playerId    String    @map("player_id") @db.Uuid
  joinedAt    DateTime  @map("joined_at") @db.Date
  leftAt      DateTime? @map("left_at") @db.Date
  shirtNumber Int?      @map("shirt_number")
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "team_player_team_id_fkey")
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "team_player_player_id_fkey")

  @@index([teamId], map: "idx_team_player_team")
  @@index([playerId], map: "idx_team_player_player")
  @@map("team_player")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Role {
  id    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String    @unique @db.VarChar(50)
  users AppUser[]

  @@map("role")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Season {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @unique(map: "uq_season_name") @db.VarChar(100)
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  version        Int             @default(0)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  leagueSeasons  LeagueSeason[]

  @@map("season")
}

model LeagueSeason {
  id             String          @id(map: "pk_league_season") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId       String          @unique(map: "uq_current_season_per_league", where: raw("(is_current = true)")) @map("league_id") @db.Uuid
  seasonId       String          @map("season_id") @db.Uuid
  isCurrent      Boolean         @default(false) @map("is_current")
  matchdayCount  Int?            @map("matchday_count")
  matchesPerMatchday Int?        @map("matches_per_matchday")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  league         League          @relation(fields: [leagueId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_league_season_league")
  season         Season          @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_league_season_season")
  matchdays      Matchday[]
  participations Participation[]

  @@unique([leagueId, seasonId], map: "uq_league_season_pair")
  @@index([seasonId], map: "idx_league_season_season")
  @@map("league_season")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model StaffMember {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName        String            @map("first_name") @db.VarChar(100)
  lastName         String            @map("last_name") @db.VarChar(100)
  nationality      String            @db.VarChar(100)
  pictureUrl       String?           @map("picture_url")
  isActive         Boolean           @default(true) @map("is_active")
  version          Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  teamStaffMembers TeamStaffMember[]

  @@map("staff_member")
}

model TeamStaffMember {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId        String      @map("team_id") @db.Uuid
  staffMemberId String      @map("staff_member_id") @db.Uuid
  jobTitle      String      @map("job_title") @db.VarChar(100)
  joinedAt      DateTime    @map("joined_at") @db.Date
  leftAt        DateTime?   @map("left_at") @db.Date
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "team_staff_member_staff_member_id_fkey")
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "team_staff_member_team_id_fkey")

  @@index([staffMemberId], map: "idx_team_staff_member_staff_member")
  @@index([teamId], map: "idx_team_staff_member_team")
  @@map("team_staff_member")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Team {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @db.VarChar(150)
  logoUrl        String?         @map("logo_url")
  stadium        String?         @db.VarChar(150)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  awayMatches    GameMatch[]     @relation("AwayTeamMatches")
  matchReservations MatchTeamReservation[]
  homeMatches    GameMatch[]     @relation("HomeTeamMatches")
  participations Participation[]
  players        TeamPlayer[]
  staffMembers   TeamStaffMember[]

  @@map("team")
}

/// Derived from active GameMatch participants by SQL triggers; do not write directly.
model MatchTeamReservation {
  matchdayId String @map("matchday_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  matchId String @map("match_id") @db.Uuid
  matchday Matchday @relation(fields: [matchdayId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  gameMatch GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([matchdayId, teamId], map: "pk_match_team_reservation")
  @@index([matchId], map: "idx_match_team_reservation_match")
  @@map("match_team_reservation")
}
