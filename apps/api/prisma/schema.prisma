  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  matchEvents MatchEvent[]
  team        Team         @relation(fields: [teamId], references: [id], onUpdate: NoAction, map: "fk_player_team")

  @@index([teamId], map: "idx_player_team")
  @@map("player")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Role {
  id    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String    @unique @db.VarChar(50)
  users AppUser[]

  @@map("role")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Season {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId       String          @unique(map: "uq_active_season_per_league", where: raw("(is_active = true)")) @map("league_id") @db.Uuid
  name           String          @db.VarChar(100)
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  isActive       Boolean         @default(false) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  matchdays      Matchday[]
  participations Participation[]
  league         League          @relation(fields: [leagueId], references: [id], onUpdate: NoAction, map: "fk_season_league")

  @@unique([leagueId, name], map: "uq_season_league_name")
  @@index([leagueId], map: "idx_season_league")
  @@map("season")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model StaffMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  firstName   String   @map("first_name") @db.VarChar(100)
  lastName    String   @map("last_name") @db.VarChar(100)
  nationality String?  @db.VarChar(100)
  jobTitle    String   @map("job_title") @db.VarChar(100)
  pictureUrl  String?  @map("picture_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  team        Team     @relation(fields: [teamId], references: [id], onUpdate: NoAction, map: "fk_staff_team")

  @@index([teamId], map: "idx_staff_team")
  @@map("staff_member")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Team {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @db.VarChar(150)
  logoUrl        String?         @map("logo_url")
  stadium        String?         @db.VarChar(150)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  awayMatches    GameMatch[]     @relation("AwayTeamMatches")
  homeMatches    GameMatch[]     @relation("HomeTeamMatches")
  participations Participation[]
  players        Player[]
  staffMembers   StaffMember[]

  @@map("team")
}
