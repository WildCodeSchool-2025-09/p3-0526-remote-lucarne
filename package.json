{
  "name": "lucarne",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run check-types",
    "check:fix": "eslint . --fix --max-warnings=0",
    "check-types": "npm run check-types --workspaces --if-present",
    "clean": "node ./bin/clean",
    "db:migrate": "npm run db:migrate --workspace=@lucarne/api",
    "db:seed": "npm run db:seed --workspace=@lucarne/api",
    "dev": "concurrently -c green,yellow -t \"HH:mm:ss\" -p \"{name} {time}\" \"npm:dev:*\"",
    "dev:web": "npm run dev --workspace=@lucarne/web",
    "dev:api": "npm run dev --workspace=@lucarne/api",
    "lint": "eslint . --max-warnings=0",
    "start": "npm run start --workspace=@lucarne/api",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@lucarne/eslint-config": "0.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.10.0",
    "validate-branch-name": "^1.3.2"
  }
}
